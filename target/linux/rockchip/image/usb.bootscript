if test -z "${devnum}"; then
	setenv devnum 0
fi

usb start
part uuid usb ${devnum}:2 uuid

if test $soc = 'rk3588'; then
	serial_addr=',0xfeb50000'; serial_port='ttyS2';
fi

setenv bootargs "console=${serial_port},1500000 earlycon=uart8250,mmio32${serial_addr} root=PARTUUID=${uuid} rw rootwait"

load usb ${devnum}:1 ${fdt_addr_r} rockchip.dtb
load usb ${devnum}:1 ${kernel_addr_r} kernel.img

booti ${kernel_addr_r} - ${fdt_addr_r}
