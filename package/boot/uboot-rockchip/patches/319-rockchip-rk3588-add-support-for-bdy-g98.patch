diff --git a/board/bdy/g98/g98.c b/board/bdy/g98/g98.c
new file mode 100644
index 00000000..ef747d6c
--- /dev/null
+++ b/board/bdy/g98/g98.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <dm/ofnode.h>
+#include <env.h>
+#include <stdio.h>
+#include <string.h>
+#include <asm/io.h>
+
+#define RK3588_BUS_IOC_GPIO2A_IOMUX_SEL_L	0xfd5f8040
+#define RK3588_BUS_IOC_GPIO2B_IOMUX_SEL_L	0xfd5f8048
+#define RK3588_BUS_IOC_GPIO2D_IOMUX_SEL_L	0xfd5f8058
+#define RK3588_BUS_IOC_GPIO2D_IOMUX_SEL_H	0xfd5f805c
+#define RK3588_BUS_IOC_GPIO3A_IOMUX_SEL_L	0xfd5f8060
+
+#define G98_GPIO2A_SFC_M0			0x000f0002
+#define G98_GPIO2D_SFC_M0			0xffff2222
+#define G98_GPIO2D_SFC_M0_CS0			0x0f000200
+#define G98_GPIO2A_EMMC				0xffff1111
+#define G98_GPIO2D_EMMC				0xffff1111
+#define G98_GPIO2D_EMMC_RST			0xffff1111
+#define G98_GPIO2B_SFC_M1_STATE			0x3033
+#define G98_GPIO2B_SFC_M1_STATE_MASK		0xf0ff
+#define G98_GPIO2D_SFC_M0_STATE			0x2222
+#define G98_GPIO2D_EMMC_STATE			0x1111
+#define G98_GPIO3A_SFC_M2_STATE			0x5555
+#define G98_IOMUX_STATE_MASK			0xffff
+
+static void g98_select_storage_route(void)
+{
+	const char *boot_source;
+
+	boot_source = ofnode_read_chosen_string("bootsource");
+	if (!boot_source)
+		return;
+
+	if (strstr(boot_source, "/spi@fe2b0000/flash@0")) {
+		/* SFC M0 uses GPIO2_A0, GPIO2_D0-D3 and GPIO2_D6. */
+		writel(G98_GPIO2A_SFC_M0, RK3588_BUS_IOC_GPIO2A_IOMUX_SEL_L);
+		writel(G98_GPIO2D_SFC_M0, RK3588_BUS_IOC_GPIO2D_IOMUX_SEL_L);
+		writel(G98_GPIO2D_SFC_M0_CS0,
+		       RK3588_BUS_IOC_GPIO2D_IOMUX_SEL_H);
+		env_set("boot_targets", "nvme usb");
+	} else if (strstr(boot_source, "/mmc@fe2e0000")) {
+		/* eMMC uses CMD, CLK, DATA, STROBE and RST on GPIO2_A/D. */
+		writel(G98_GPIO2A_EMMC, RK3588_BUS_IOC_GPIO2A_IOMUX_SEL_L);
+		writel(G98_GPIO2D_EMMC, RK3588_BUS_IOC_GPIO2D_IOMUX_SEL_L);
+		writel(G98_GPIO2D_EMMC_RST,
+		       RK3588_BUS_IOC_GPIO2D_IOMUX_SEL_H);
+		env_set("boot_targets", "mmc0 nvme usb");
+	}
+}
+
+static void g98_report_storage_route(void)
+{
+	u32 gpio2a, gpio2b, gpio2d, gpio3a;
+	const char *route = "unknown";
+
+	gpio2a = readl(RK3588_BUS_IOC_GPIO2A_IOMUX_SEL_L);
+	gpio2b = readl(RK3588_BUS_IOC_GPIO2B_IOMUX_SEL_L);
+	gpio2d = readl(RK3588_BUS_IOC_GPIO2D_IOMUX_SEL_L);
+	gpio3a = readl(RK3588_BUS_IOC_GPIO3A_IOMUX_SEL_L);
+
+	if ((gpio2d & G98_IOMUX_STATE_MASK) == G98_GPIO2D_SFC_M0_STATE)
+		route = "SFC M0";
+	else if ((gpio2b & G98_GPIO2B_SFC_M1_STATE_MASK) ==
+		 G98_GPIO2B_SFC_M1_STATE)
+		route = "SFC M1";
+	else if ((gpio3a & G98_IOMUX_STATE_MASK) == G98_GPIO3A_SFC_M2_STATE)
+		route = "SFC M2";
+	else if ((gpio2d & G98_IOMUX_STATE_MASK) == G98_GPIO2D_EMMC_STATE)
+		route = "eMMC";
+
+	printf("G98 storage route: %s (2A=%08x 2B=%08x 2D=%08x 3A=%08x)\n",
+	       route, gpio2a, gpio2b, gpio2d, gpio3a);
+}
+
+int rk_board_late_init(void)
+{
+	g98_select_storage_route();
+	g98_report_storage_route();
+
+	return 0;
+}
